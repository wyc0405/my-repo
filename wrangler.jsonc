{
  // ★ name 은 Cloudflare 대시보드의 Worker 이름과 똑같이 (지금 쓰는 값 그대로 두세요)
  "name": "my-repo",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  // 대시보드에서 넣은 변수를 GitHub 배포 때 지우지 않고 그대로 둠 (텔레그램 값을 'Text'로 넣었어도 유지)
  "keep_vars": true,
  // 텔레그램 알림 예약 실행 (UTC 기준, 월~금)
  //   ※ 클라우드플레어는 요일 번호가 1=일요일이라 "1-5"는 일~목이 됨 → 반드시 MON-FRI 로 쓸 것
  //   "30 12 * * MON-FRI" → 한국시간 평일 21:30 사전 알림
  //   "20 20 * * MON-FRI", "20 21 * * MON-FRI" → 미국 16:20 ET 확정 알림 (서머타임/겨울 중 맞는 쪽만 실제로 보냄)
  "triggers": {
    "crons": ["30 12 * * MON-FRI", "20 20 * * MON-FRI", "20 21 * * MON-FRI"]
  }
}
